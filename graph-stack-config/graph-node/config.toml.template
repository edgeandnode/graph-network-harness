# Graph Node configuration for harness
# Ports are substituted at runtime: {postgres_port}, {anvil_port}, {ipfs_port}

[store]
[store.primary]
connection = "postgresql://graph-node:graph-password@localhost:{postgres_port}/graph-node"
pool_size = 10

[deployment]
[[deployment.rule]]
store = "primary"
indexers = ["default"]

[chains]
ingestor = "default"

[chains.mainnet]
shard = "primary"
provider = [
  { label = "anvil", url = "http://localhost:{anvil_port}", features = ["traces"] }
]
