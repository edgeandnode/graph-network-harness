# Graph Node configuration for harness
# Ports are substituted at runtime using {service.port.name} syntax

[store]
[store.primary]
connection = "postgresql://graph-node:graph-password@localhost:{postgres.port.main}/graph-node"
pool_size = 10

[general]
query = "http://localhost:{graph-node.port.http}"

[deployment]
[[deployment.rule]]
store = "primary"
indexers = ["default"]

[chains]
ingestor = "default"

[chains.mainnet]
shard = "primary"
provider = [
  { label = "anvil", url = "http://localhost:{anvil.port.rpc}", features = ["traces"] }
]
